---
import type { ElementView } from "../lib/entries.ts";

interface Props {
  element: ElementView;
}

const { element } = Astro.props;
---

{/* Labels and values in two aligned columns, one fact per row. The lines are taller than 1.5, or
   code chips on consecutive lines of a role context touch. */}
<dl class="grid grid-cols-[max-content_minmax(0,1fr)] gap-x-4 narrow:grid-cols-1 gap-y-1 text-sm leading-relaxed" data-facts>
  <dt class="text-muted">Default CSS</dt>
  <dd>
    <code>display: <span class="whitespace-nowrap">{element.display}</span></code>
  </dd>
  <dt class="text-muted">Accessibility role</dt>
  <dd>
    {element.role ? (
      <>
        <a href={element.role.href}>{element.role.name}</a>, {element.role.gloss}
        {element.role.context && <span set:html={`; ${element.role.context}`} />}
      </>
    ) : (
      "none of its own"
    )}
  </dd>
</dl>
