{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":rebaseStalePrs"
  ],
  "labels": [
    "dependencies"
  ],
  "automergeType": "pr",
  "ignoreTests": false,
  "internalChecksFilter": "strict",
  "minimumReleaseAge": "7 days",
  "minimumReleaseAgeBehaviour": "timestamp-required",
  "statusCheckWhen": {
    "minimumReleaseAge": "never"
  },
  "pinDigests": true,
  "platformAutomerge": false,
  "rangeStrategy": "pin",
  "dependencyDashboardApproval": false,
  "prConcurrentLimit": 0,
  "branchConcurrentLimit": 0,
  "separateMajorMinor": true,
  "separateMultipleMajor": true,
  "separateMinorPatch": false,
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": [
      "security"
    ],
    "minimumReleaseAge": null,
    "schedule": [],
    "updateNotScheduled": true,
    "groupName": null,
    "groupSlug": null
  },
  "packageRules": [
    {
      "description": "Merge every update once CI passes; keep unrelated dependencies separate.",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "pinDigest",
        "digest"
      ],
      "automerge": true
    },
    {
      "matchPackageNames": [
        "node",
        "@types/node",
        "typescript"
      ],
      "groupName": "Node and TypeScript toolchain",
      "groupSlug": "node-typescript-toolchain"
    },
    {
      "matchManagers": [
        "npm"
      ],
      "matchDepTypes": [
        "engines"
      ],
      "rangeStrategy": "replace"
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": true,
      "addLabels": [
        "major update"
      ],
      "description": "Majors automerge too once CI passes: the unit, accessibility, end-to-end and screenshot tests are the gate (docs/adr/0008-automerge-every-dependency-update-that-passes-ci.md)."
    }
  ]
}
