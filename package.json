    "@types/node": "26.6.5",
    "axe-core": "4.14.0",
    "node-html-parser": "9.0.5",
    "shiki": "4.5.0",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "workbox-build": "7.4.1",
    "yaml": "2.9.1"
  },
  "packageManager": "pnpm@12.15.0"
