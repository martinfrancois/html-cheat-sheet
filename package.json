{
  "name": "html-cheat-sheet",
  "version": "2.0.0",
  "description": "Every HTML element and global attribute with a description, key attributes, browser support, and live examples you can edit",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "François Martin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/martinfrancois/html-cheat-sheet.git"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/build-service-worker.ts",
    "preview": "astro preview",
    "check": "astro check",
    "test": "node --test \"test/*.test.ts\"",
    "test:e2e": "sh scripts/playwright.sh",
    "sync-spec": "node scripts/sync-spec.ts",
    "format-examples": "node scripts/format-examples.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
