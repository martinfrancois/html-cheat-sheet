    "@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
    "@fontsource-variable/martian-mono": "5.3.0",
    "@leeoniya/ufuzzy": "1.0.19",
    "@lezer/highlight": "1.2.5",
    "@lucide/astro": "1.61.0",
    "@mdn/browser-compat-data": "8.1.6",
    "@tailwindcss/vite": "4.3.3",
    "@webref/elements": "2.9.2",
    "astro": "7.4.1",
    "browserslist": "4.29.4",
    "caniuse-lite": "1.0.30001818",
    "codemirror": "6.0.2",
    "marked": "18.1.1",
    "posthog-js": "1.438.13",
    "tailwindcss": "4.3.3",
    "web-features": "3.43.0",
    "workbox-window": "7.4.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.11",
    "@axe-core/playwright": "4.14.0",
